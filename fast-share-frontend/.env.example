# Supabase Postgres — Connect -> Transaction pooler (port 6543)
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Supabase Storage — Project Settings -> API Keys (service_role key; server-only)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SECRET_KEY=

# Protects /api/cron/cleanup — any long random string (openssl rand -hex 24)
CRON_SECRET=

# Realtime (browser). Public by design: RLS blocks table access; channels use per-room secret keys.
# Supabase -> Project Settings -> API Keys -> anon (legacy) key
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
